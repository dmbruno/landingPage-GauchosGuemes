                        </g>
                    </svg>
                    <a href="mailto:salongauchoguemes@gmail.com" target="_blank">salongauchoguemes@gmail.com</a>
                </div>
                <div class="ubicacionContenedor">
                    <svg  width="24" height="24" viewBox="0 0 16 17" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
