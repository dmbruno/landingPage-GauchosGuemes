        </div>
    </div>
    <div class="abajo">
        <img src={esquinaAbI.src} alt="" />
        <img src={esquinaAbD.src} alt="" />
    </div>
</footer>

<style>
    .footer {
        display: flex;
        flex-direction: column;
        gap: var(--space-24px);
        align-items: center;
        justify-content: center;
        color: var(--color-neutral-50);
        background-color: var(--color-bordo);
        padding-top: var(--space-24px);
        padding-bottom: var(--space-24px);
    }
    .arriva,
    .abajo {
        display: flex;
        width: 100%;
        justify-content: space-between;
    }
    .centro {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-32px);
        width: 100%;
    }
    .centro__titulo {
        font-weight: var(--font-weight-bold);
        line-height: var(--line-height-4xl);
        font-size: var(--font-size-32px);
    }
    .centro__contenedorContenido {
        display: flex;
        flex-direction: column;
        gap: var(--space-32px);
        align-items: flex-start;
        justify-content: center;
        width: 100%;
    }
    .arribaIzquierda__navList {
        display: flex;
        flex-direction: column;
        gap: var(--space-16px);
    }
    .arribaIzquierda__navItem {
        padding-left: var(--space-8px);
        border-left: 2px solid var(--color-amarillo);
    }
    .arribaIzquierda__navLink {
        font-weight: var(--font-weight-medium);
        line-height: var(--line-height-lg);
        font-size: var(--font-size-16px);
    }

    .copyRight--desktop {
        display: none;
    }
    .contenedorContenido__abajoDerecha {
        display: flex;
        flex-direction: column;
        gap: var(--space-24px);
        padding-bottom: var(--space-32px);
        align-items: flex-start;
        width: 100%;
        border-bottom: 0.1px solid var(--color-amarillo);
        max-width: 446px;
    }
    .logo {
        height: 80px;
    }
    .mailContenedor,
    .ubicacionContenedor {
        display: flex;
        gap: var(--space-8px);
        align-items: center;
    }
    .redesContenedor {
        display: flex;
        gap: var(--space-16px);
    }
    .instagram:hover,
    .facebook:hover,
    .whatsapp:hover{
        color: var(--color-amarillo);
    }
    .ubicacionContenedor:hover svg{
        color: var(--color-amarillo);
    }
    .mailContenedor:hover svg{
        color: var(--color-amarillo);
    }
    .copyRight--mobile{
      display: flex;
      flex-direction: column;
      gap: var(--space-4px);
      text-align: center;
    }
    .linkSaltaLabs{
        color: #FCF260;
        text-decoration: underline;
    }
  @media (min-width: 1024px) {
        .footer{
            gap: var(--space-32px);
        }
        .centro__contenedorContenido {
            display: flex;
            flex-direction: row;
            gap: var(--space-32px);
            align-items: flex-start;
            justify-content: space-between;
            width: 100%;
        }
        .contenedorContenido__arribaIzquierda {
            display: flex;
            flex-direction: column;
            gap: var(--space-56px);
            max-width: 606px;
        }
        .contenedorContenido__abajoDerecha{
            border-bottom: none;
        }
        .arribaIzquierda__navList {
            gap: var(--space-24px);
        }
        .arribaIzquierda__navItem {
            padding-left: var(--space-16px);
        }
        .arribaIzquierda__navLink {
            font-weight: var(--font-weight-medium);
            line-height: var(--line-height-lg);
            font-size: var(--font-size-18px);
            transition: color 0.3s ease-out;
        }
        .arribaIzquierda__navLink:hover {
            color: var(--color-amarillo);
        }
        .copyRight--mobile{
            display: none;
        }
        .copyRight--desktop {
            display: flex;
            flex-direction: column;
            gap: var(--space-4px);
        }
  }
</style>
