---
import esquinaArI from "../assets/iconos/esquina-AI.svg";
import esquinaArD from "../assets/iconos/esquina-AD.svg";
import esquinaAbI from "../assets/iconos/esquina-AbI.svg";
import esquinaAbD from "../assets/iconos/esquina-AbD.svg";

import logo from "../assets/imgs/logoBlanco.png";
---

<footer id="footer" class="footer padding-lateral">
    <div class="arriva">
        <img src={esquinaArI.src} alt="" />
        <img src={esquinaArD.src} alt="" />
    </div>
    <div class="centro">
        <h2 class="centro__titulo">El lugar que tu evento merece</h2>
        <div class="centro__contenedorContenido">
            <div class="contenedorContenido__arribaIzquierda">
                <ul class="arribaIzquierda__navList">
                    <li class="arribaIzquierda__navItem">
                        <a class="arribaIzquierda__navLink" href="/#presentacion">Inicio</a>
                    </li>
                    <li class="arribaIzquierda__navItem">
                        <a class="arribaIzquierda__navLink" href="/#eventos">Eventos</a>
                    </li>
                    <li class="arribaIzquierda__navItem">
                        <a class="arribaIzquierda__navLink" href="/#galeria">Galería</a>
                    </li>
                    <li class="arribaIzquierda__navItem">
                        <a class="arribaIzquierda__navLink" href="/#faq">Preguntas Frecuentes</a>
                    </li>
                    <li class="arribaIzquierda__navItem">
                        <a class="arribaIzquierda__navLink" href="políticaDePrivacidad">Política de Privacidad</a>
                    </li>
                </ul>
                <div class="copyRight--desktop">
                    <p class="caption">
                        © 2025 Gauchos de Güemes, eventos y convenciones. Todos los
                        derechos reservados.
                    </p>
                    <p class="caption">
                        Powered by <a class="linkSaltaLabs" href="https://saltalabs.com/es/" target="_blank"
                        >SaltaLABS</a
                        >
                    </p>
                </div>
            </div>
            <div class="contenedorContenido__abajoDerecha">
                <img class="logo" src={logo.src} alt="" />
                <div class="mailContenedor">
                    <svg  width="24" height="24" viewBox="0 0 16 17" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                        <mask id="mask0_183_4808" style="mask-type:alpha" maskUnits="userSpaceOnUse" x="0" y="0" width="16" height="17">
